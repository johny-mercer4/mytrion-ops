# --- Server ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
# Allowed origin suffixes (comma-separated). Zoho widgets run on per-instance subdomains
# of zappsusercontent.com, so that whole suffix is allowed (reflected, not "*").
CORS_ORIGIN_SUFFIXES=zappsusercontent.com

# --- Database: Mytrion OPS external Postgres (sessions, logging, knowledge) ---
# The only app DB — no local DB. Required at runtime (the app fails fast if unset).
MYTRION_OPS_DATABASE_URL=
DATABASE_POOL_MAX=10

# --- Mytrion Admin Data Loader (self-hosted NocoDB) ---
# Backend launch link. Keep production internal/IP-restricted; this is never a public app URL.
NOCODB_BASE_URL=http://127.0.0.1:8080
# NocoDB container URL generation (legacy name: NC_PUBLIC_URL).
NOCODB_SITE_URL=http://127.0.0.1:8080
NOCODB_METADATA_PASSWORD=6dae2cb9e7208c30f8a7e23773a6f635b637cc29349b2ea52b38111c2f55c942              # URL-encode reserved characters before using in NC_DB
NOCODB_AUTH_JWT_SECRET=2e80daac2bffce09b31178245d3483c6120010a2e328122aaeb312f8eba0ce8b                # long random value; NocoDB login sessions
NOCODB_CONNECTION_ENCRYPT_KEY=15fd7648ec360a0a6e8d211cc5058b49952497746f0c3abd9b95ea095406e343         # stable random value; encrypts saved data-source credentials
# One loader role is pinned to exactly one app tenant by native Postgres RLS.
NOCODB_LOADER_TENANT_ID=octane
NOCODB_LOADER_PASSWORD=a7d4a8f78978d487bc40fa67243a7804c84face7c0b34fd6549fccbe120f4dac
# Paste this into NocoDB's "Connect External Data" flow; never use MYTRION_OPS_DATABASE_URL there.
NOCODB_LOADER_DATABASE_URL=postgresql://mytrion_loader:a7d4a8f78978d487bc40fa67243a7804c84face7c0b34fd6549fccbe120f4dac@postgres:5432/octane_assistant
#
# Production deployment is a separate legal/network decision. render.yaml intentionally has no
# NocoDB service; current Community licensing is Fair Code Sustainable Use, not the older AGPL note.

# --- Data Warehouse (separate read Postgres; tool + metadata target) ---
DWH_DATABASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=
# Model IDs by role: FOUR_O_MINI = default chat, FIVE_O_MINI = reasoning, EMBEDDING_SMALL = vectors.
OPEN_AI_FOUR_O_MINI=gpt-4o-mini-2024-07-18
OPEN_AI_FIVE_O_NANO=gpt-5.4-nano
OPEN_AI_FIVE_O_MINI=gpt-5.4-mini-2026-03-17
OPEN_AI_HARD_MODEL=gpt-5.4-mini-2026-03-17
OPEN_AI_EMBEDDING_SMALL=text-embedding-3-small
OPENAI_TIMEOUT_MS=60000              # SDK deadline for every raw OpenAI/Groq call
LLM_MAX_OUTPUT_TOKENS=4096           # output cap for chat-pipeline completions
EMBED_BATCH_SIZE=128                 # max inputs per embeddings.create request

# --- Groq (fast/cheap worker via OpenAI-compatible API; off unless FF_GROQ_ENABLED=1) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_WORKER=openai/gpt-oss-120b

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_PEPPER=

# --- Encryption (for vendor credentials at rest) ---
ENCRYPTION_KEY=                  # 32 bytes base64

# --- Zoho: shared OAuth app (one self-client app across CRM/Desk/People/Projects) ---
# Set ZOHO_ACCOUNTS_DOMAIN to your data center: .com | .eu | .in | .com.au | .jp | .ca
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Optional shared refresh token; fallback when a service-specific token is unset.
ZOHO_REFRESH_TOKEN=

# *_API_DOMAIN / *_BASE_URL are the FULL versioned API roots; code appends the resource path.

# --- Zoho CRM ---
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com/crm/v8

# --- Zoho Desk ---
ZOHO_DESK_REFRESH_TOKEN=
ZOHO_DESK_BASE_URL=https://desk.zoho.com/api/v1
ZOHO_DESK_ORG_ID=

# --- Zoho People ---
ZOHO_PEOPLE_REFRESH_TOKEN=
ZOHO_PEOPLE_BASE_URL=https://people.zoho.com/api

# --- Zoho Projects ---
ZOHO_PROJECTS_REFRESH_TOKEN=
ZOHO_PROJECTS_BASE_URL=https://projectsapi.zoho.com/api/v3

# --- RingCentral (Sales Mytrion Embeddable softphone) ---
# App from https://developers.ringcentral.com — scopes: VoIP Calling, WebSocket Subscriptions,
# Read Contacts, Read Messages, SMS, Read Call Log (the contacts/messages tabs only appear once the
# token carries the read scopes). Default sign-in = per-agent OAuth in the widget: only CLIENT_ID is
# required. CLIENT_SECRET + JWT are OPTIONAL — the shared-extension auto-login (all agents dial as
# one user), embedded ONLY when RINGCENTRAL_BROWSER_CREDS_ACK=1. Keep secrets server-side otherwise.
#
# REQUIRED in RingCentral Developer Console → your app → Auth → OAuth Redirect URI, matching
# RINGCENTRAL_REDIRECT_URI below (Embeddable uses THIS redirect, NOT your Render URL — OAU-113 =
# empty redirect list). Auth type: 3-legged OAuth (authorization code) · Client-side web app (SPA/JS).
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_REDIRECT_URI=https://apps.ringcentral.com/integration/ringcentral-embeddable/latest/redirect.html
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
# FF_RINGCENTRAL_ENABLED=1  (see feature flags below)

# --- Gong (Call Hub Phase 2 — recordings/transcripts; off until client is wired) ---
# FF_GONG_ENABLED=0
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://api.gong.io

# --- Zoho MCP (feasibility spike; see `pnpm zoho:mcp-probe`) ---
# Per-server URL generated in the Zoho MCP console (embeds a secret API key → treat as a password).
ZOHO_MCP_URL=
# Optional: a separate bearer token, only if the console issues one alongside the URL.
ZOHO_MCP_AUTH=

# --- dbt MCP (hosted warehouse-analytics MCP; server-to-server via OAuth client_credentials) ---
# Agents reach the DWH ONLY through this MCP (not the direct DWH_DATABASE_URL pool).
# FF_DBT_MCP_ENABLED defaults ON. JSON-RPC endpoint (usually the deploy origin + /mcp).
DBT_MCP_URL=
# Token endpoint; leave blank to derive `${origin}/token` from DBT_MCP_URL.
DBT_MCP_TOKEN_URL=
# client_credentials pair issued by the dbt MCP (its OAUTH_CLIENTS). Treat the secret as a password.
DBT_MCP_CLIENT_ID=
DBT_MCP_CLIENT_SECRET=
# Optionally expose dbt run/test (write). Default is read-only (recall + query).
# FF_DBT_MCP_WRITES=0

# --- Department RBAC ---
# EXACT Zoho profile/role names (CSV) that grant UNLIMITED access (all departments' RAG + all
# tools). Case-insensitive FULL-STRING equality after trim — NOT substring: 'manager' used to
# also match "Sales Manager"/"Account Manager" and silently made sales staff admins. Restore a
# wrongly-demoted individual via ADMIN_USERS or a worker_mytrion_access DB override (no deploy).
ADMIN_PROFILE_MARKERS=administrator,ceo
# CS Mytrion manager tier (leaderboard / org-wide analytics / roster) — substring match
# against the caller's Zoho profile AND role (e.g. 'manager' matches "Customer Service Manager").
CS_MANAGER_ROLE_MARKERS=manager,director,administrator

# --- Vendor: Octane internal API (placeholder) ---
OCTANE_INTERNAL_API_URL=
OCTANE_INTERNAL_API_KEY=
SUPPORT_BOT_GATEWAY_API_KEY=             # dedicated backend inbound key; never reuse API_KEY in production
SUPPORT_BOT_GATEWAY_MONITOR_URL=          # Render URL for apps/agent-gateway-v2, e.g. https://octane-agent-gateway.onrender.com
SUPPORT_BOT_GATEWAY_MONITOR_TOKEN=        # same >=32-char value as gateway MONITOR_TOKEN; injected only after backend admin auth

# --- Inbound server API key (callers present this to reach this engine) ---
API_KEY=

# --- Inbox-message webhook secret (Zoho CRM Org_Module → mytrion_inbox_messages). Presented in the
#     `x-inbox-secret` header; scoped to POST /v1/inbox/messages/webhook only (NOT the full API_KEY). ---
INBOX_WEBHOOK_SECRET=45fecbb171cc73d71624b4e7836b15fd86724f88bc2c4c191ef9a8d1b882086c

# Rejection-report webhook (Zoho Desk Deluge -> mytrion_rejection_reports). Sent by the
# Deluge in the `x-rejection-secret` header; scoped to that one endpoint, NOT the API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REJECTION_WEBHOOK_SECRET=

# --- HR attendance webhook (Hikvision / servercrm → Mytrion punches) ---
# Header: x-attendance-webhook-secret. Blank → POST /v1/hr/attendance/webhook returns 503.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HR_ATTENDANCE_WEBHOOK_SECRET=631594807439ea0ef671384cfc86902bbda76cd6ffffa4e3de5c0ad236d9034f

# --- Sales KPI collection ---
# Deploy migrations/UI first, then enable telemetry + pg-boss collectors in shadow mode.
FF_KPI_COLLECTION_ENABLED=0
KPI_REPORTING_TZ=America/New_York
# External automation task-create credential. Sign:
#   <unix-seconds>.<canonical-json-body> with HMAC-SHA256; send the hex digest.
MYTRION_TASK_WEBHOOK_KEY_ID=external-automation
MYTRION_TASK_WEBHOOK_SECRET=

# --- CMP (our custom Node server; login/password auth, prod + sandbox) ---
CMP_ENV=sandbox            # which environment the CMP wrapper authenticates against
CMP_PRODUCTION_URL=
CMP_PRODUCTION_LOGIN=
CMP_PRODUCTION_PASSWORD=
CMP_SANDBOX_URL=
CMP_SANDBOX_LOGIN=
CMP_SANDBOX_PASSWORD=

# --- EFS (CardManagement SOAP/WSDL) ---
EFS_WSDL_URL=
EFS_GROUP_WSDL_URL=        # CarrierGroupWS WSDL; derived from EFS_WSDL_URL when blank
EFS_LOGIN=
EFS_PASSWORD=
EFS_PARENT=PARENT

# --- Server CRM (outbound integration) ---
SERVER_CRM_URL=
SERVER_CRM_KEY=

# --- Browser automation microservice (BOCA / Close Application) ---
BROWSER_AUTOMATION_URL=
BROWSER_AUTOMATION_KEY=
BROWSER_AUTOMATION_TIMEOUT_MS=300000

# --- Zapier catch-hook (card replacement / account reactivation) ---
# Same URL the Zoho widget posts to (hooks.zapier.com/hooks/catch/…/433y0ax/).
ZAPIER_TICKET_WEBHOOK_URL=

# --- File storage: Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Leave blank to derive https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public/custom-domain base for serving uploaded files
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# --- Browser automation: Browserbase ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_BASE_URL=https://api.browserbase.com

# --- Feature flags ---
FF_PARTNER_AUDIENCE_ENABLED=1
FF_KNOWLEDGE_INGEST_ENABLED=1
FF_RAG_ENABLED=1
FF_GROQ_ENABLED=1
# Expose Zoho MCP tools to the chat agent (needs ZOHO_MCP_URL). Read tools only unless …_WRITES=1.
FF_ZOHO_MCP_ENABLED=0
FF_ZOHO_MCP_WRITES=0
# Warehouse MCP (dbt) — agent DWH path. Needs DBT_MCP_URL + client id/secret.
FF_DBT_MCP_ENABLED=1
FF_DBT_MCP_WRITES=0
FF_RINGCENTRAL_ENABLED=0
FF_GONG_ENABLED=0
FF_AUDIT_LOG_ENABLED=1

# ============================================================
# Agentic Core v2 (2026-07-02) — orchestrator + 10 dept agents
# ============================================================

# --- Multi-agent orchestrator (POST /v1/agent) ---
FF_ORCHESTRATOR_ENABLED=1            # gates /v1/agent (+ legacy alias FF_DEEP_AGENTS_ENABLED)
FF_AGENT_CHECKPOINTS=1               # durable LangGraph threads (schema 'langgraph', setup via migrate)
AGENT_CONTEXT_PAGE_CHARS=32000       # mid-history char budget before MemGPT paging
AGENT_CONTEXT_KEEP_RECENT=19         # trailing messages kept when paging
AGENT_GOAL_RECITE_EVERY=4            # re-anchor goal every N user turns
FF_AGENT_BLACKBOARD=1                # shared JSON blackboard for supervisor↔workers
AGENT_BLACKBOARD_MAX_CHARS=16384
FF_AGENT_SKILL_CACHE=1               # procedural skill cache (winning trajectories)
AGENT_SKILL_SIMILARITY_THRESHOLD=0.78
AGENT_SKILL_MAX_PER_KEY=200
FF_AGENT_PLAN_DAG=1                  # Plan-and-Execute JSON DAG on orchestrator
FF_AGENT_HARD_DAG=1                  # deterministic wave executor for ready DAG nodes
AGENT_PLAN_MAX_NODES=8
AGENT_PLAN_MAX_PARALLEL=3
AGENT_PLAN_MAX_REPLANS=2
FF_CRAG_WEB_FALLBACK=0               # external-only fallback; never substitutes Octane policy/SOP evidence
FF_AGENT_GRAPH_CACHE=1              # reuse compiled agent graph across turns (keyed by agent+identity)
ORCHESTRATOR_MODEL=                  # '' -> DEEP_AGENTS_MODEL -> default chat model
AGENT_CHILD_MODEL=                   # default child-agent model ('' -> default chat model)
AGENT_MAX_CHILD_ITERATIONS=8
AGENT_TOOL_OUTPUT_MAX_CHARS=8000
AGENT_MAX_TOOL_CALLS=20              # per-run budget guards
AGENT_MAX_COST_USD=0.50
AGENT_MAX_WALL_MS=120000
AGENT_MODEL_TIMEOUT_MS=90000         # per-call deadline for agent-path ChatOpenAI requests
AGENT_MAX_OUTPUT_TOKENS=4096         # output cap for agent-path model calls
OUTBOUND_HTTP_TIMEOUT_MS=30000       # deadline for outbound integration HTTP (serverCrm/Zoho)
ACT_AS_DIRECTORY_TTL_MS=300000       # cache TTL for the CRM users directory verifying act-as targets
AGENT_CHECKPOINT_TTL_DAYS=30
FF_CUSTOMER_SCOPE_STRICT=1           # DEFAULT ON: customer callers locked to their company tag; 0 = temporary legacy rollback
FF_WORKER_DEPT_STRICT=0              # LEGACY/unused: verified worker access is now DB-resolved (mytrion_profile_defaults + worker_mytrion_access), not profile-substring
FF_SESSION_DEPT_AUTHORITATIVE=1      # DEFAULT ON: verified-session department grant is server-authoritative (ignore client-claimed access). Required for DB-backed User Management
FF_ZOHO_OAUTH_ENABLED=1              # default ON — Zoho OAuth worker sign-in (required for DB access rules; 0 = emergency static-key bypass only)

# --- Zoho OAuth WORKER sign-in (the login flow) ---
# A SEPARATE "server" app in the Zoho console from the tool-integration creds above.
ZOHO_SERVER_CLIENT_ID=
ZOHO_SERVER_CLIENT_SECRET=
# MUST byte-match a redirect URI registered on that server app. Either form works:
#   https://<your-host>/v1/auth/zoho/callback  → the API bounces the browser to PORTAL_BASE_URL
#   https://<your-host>/                       → the portal reads ?code&state itself
# Getting this wrong is a TOTAL sign-in outage, so set it explicitly — the default below is dev-only.
ZOHO_OAUTH_REDIRECT_URI=http://localhost:5173
# Where the API sends the browser after Zoho redirects to the API's own callback path. '/' is right in
# prod (the portal is served same-origin at root); use http://localhost:5173 for a separate Vite port.
PORTAL_BASE_URL=/
#LANGSMITH_TRACING=true              # optional tracing (staging only — traces contain content)
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=octane-staging

# --- Background jobs: pg-boss (own 'pgboss' schema on the app DB) ---
# Retention workflow notify targets (Zoho CRM user ids). Empty = skip that recipient.
# Open Pool entry → inbox + realtime for Ryan + previous deal owner (owner from case row).
# Outbound email is Zapier (not app Zoho send_mail).
RETENTION_OPEN_POOL_NOTIFY_ZOHO_USER_ID=6227679000000678055
RETENTION_OPS_MANAGER_ZOHO_USER_ID=6227679000004676064
# Reserved / Zapier From identity — unused by the API for Open Pool mail.
RETENTION_NOTIFY_FROM_EMAIL=customer@octanefuel.com
# Phase 2 Retention CS assignee (first Zoho user id wins — no RoundRobin). Kept disabled via
# RETENTION_AUTO_ASSIGN_ENABLED in csRoundRobin.ts until product turns it on.
RETENTION_CS_ROUND_ROBIN_ZOHO_USER_IDS=6227679000000461001
# Spanish Retention desk (bypasses fixed assignee when case is_spanish_desk). Jean Paul Escudero.
RETENTION_CS_SPANISH_ZOHO_USER_ID=6227679000065094200
# Pilot: when FF_RETENTION_PILOT_ONLY=1, auto-create cases only for these Sales agents
# (comma-separated Zoho user ids). Off / empty list with flag on = create none.
# Daniel Brown (test): 6227679000031473048
FF_RETENTION_PILOT_ONLY=0
RETENTION_PILOT_AGENT_ZOHO_USER_IDS=

FF_JOBS_ENABLED=0
JOBS_WORKER_MODE=inline              # inline | send-only (dedicated dist/worker.js) | off
PGBOSS_SCHEMA=pgboss
JOBS_CONCURRENCY=2
JOBS_CRON_TZ=America/Chicago

# --- Agentic RAG ---
FF_RAG_HYBRID=0                      # vector + full-text RRF (requires content_tsv migration)
FF_AGENTIC_RAG=1                     # multi-query loop + CRAG grade + [Sn] citations
FF_RAG_RERANK=0
RAG_PLANNER_MODEL=
RAG_MAX_HOPS=2
RAG_MULTIQUERY_MAX=3
RAG_RRF_K=60
RAG_CANDIDATES_PER_LEG=30
RAG_SUFFICIENT_SCORE=0.032
RAG_RETRIEVAL_STRATEGY=exact          # exact | ann | shadow; exact is correct default for the current corpus
RAG_ANN_MIN_ELIGIBLE_CHUNKS=10000
RAG_HNSW_EF_SEARCH=100
RAG_MIN_COSINE_SCORE=0.5
RAG_NO_MATCH_TTL_SECONDS=900
FF_RAG_V2_CONTEXT=0                   # opt in after migration; canary by tenant/department at deployment layer
FF_RAG_V2_RETRIEVAL=0                 # one-flag rollback to the existing agentic RAG path
FF_RAG_CLAIM_VERIFY=0
FF_PLATFORM_KNOWLEDGE=0
FF_RAG_MODEL_POLICY=0
STALE_DOC_DAYS=180                   # unverified docs older than this are demoted + flagged

# --- Files: MinIO / any S3-compatible store (R2 = endpoint+region swap) ---
FF_FILES_ENABLED=0
S3_ENDPOINT=                         # e.g. http://localhost:9000 (docker minio) / https://minio.yourhost
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=octane-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1                # MinIO=1; R2=0
S3_PRESIGN_TTL_SECONDS=900
FILE_MAX_SIZE_MB=25
PARSE_MAX_BYTES=10485760

# --- Dropbox: storage for COMMS CHAT ATTACHMENTS ---
# Where a NEW comms attachment goes. Per-provider, not global: every existing file_assets row is on S3 and
# records that, so flipping this only changes the next upload. Existing files keep resolving to S3.
COMMS_STORAGE_PROVIDER=s3            # s3 | dropbox
# Refresh-token grant (Dropbox access tokens last ~4h, so the refresh token is the durable credential).
# Create a Dropbox app with `files.content.write` + `files.content.read` + `sharing.write` scopes, then do
# the one-time authorization-code exchange to obtain the refresh token.
# IMPORTANT: leave refresh-token ROTATION OFF on the app — there is nowhere in this schema to persist a
# rotated token, so a rotating app would keep using a dead credential until this env is updated by hand.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/comms             # tenant + thread are appended under this prefix
# SEPARATE from FILE_MAX_SIZE_MB, which zod caps at 200. The global multipart ceiling is the max of the two,
# so raising this alone is enough for bigger chat files.
COMMS_ATTACHMENT_MAX_MB=50

# --- Realtime WebSocket (GET /v1/realtime + GET /v1/carrier/mini-app/realtime) ---
# Protocol-ping interval AND the reap deadline: a socket that ignored the previous sweep's ping
# is terminated on the next one, so a dead socket is dropped within 2 intervals and its hub
# subscriptions are freed. Render imposes no fixed WS timeout, but a CDN in front (Cloudflare)
# caps WS at 100s — 25s stays under 75% of that. Min 1000.
REALTIME_PING_INTERVAL_MS=25000

# --- Agent presence (ticket round-robin only assigns to an available ONLINE agent) ---
# Ships dark: when off, sockets are not tracked and nothing is written to mytrion_agent_presence,
# so the table and the heartbeat can land well before ticket assignment exists. Turn on together
# with the comms ticketing surface.
FF_COMMS_PRESENCE=0
# Lease refresh cadence. Must be >= REALTIME_PING_INTERVAL_MS.
PRESENCE_REFRESH_MS=30000
# How old a lease may be and still count as online. Must be > 2x PRESENCE_REFRESH_MS or connected
# agents flicker offline between refreshes and stop receiving tickets. Asserted at boot.
PRESENCE_STALE_MS=90000

# --- Browser automation via Composio toolkits ---
FF_BROWSER_ENABLED=0
FF_BROWSER_WRITES=0                  # interactive navigate/click/fill actions
COMPOSIO_BROWSER_TOOLKITS=FIRECRAWL  # verify interactive-browser slug in the Composio dashboard
BROWSER_ALLOWED_DOMAINS=             # CSV hostname suffixes; EMPTY = deny all navigation (fail closed)
COMPOSIO_RATE_PER_MIN=30

# --- Write approvals + agent memory ---
FF_WRITE_APPROVALS=0                 # agent-proposed writes park at /v1/approvals (24h TTL)
FF_AGENT_MEMORY=0                    # distill + recall long-term agent memory
AGENT_MEMORY_HALFLIFE_DAYS=30
AGENT_MEMORY_MAX_PER_KEY=500
FF_SUPPORT_BOT_MEMORY=0              # per-user Telegram pgvector history; migration 0078
SUPPORT_BOT_MEMORY_TTL_DAYS=30
SUPPORT_BOT_MEMORY_MAX_PER_USER=200
SUPPORT_BOT_MEMORY_TOP_K=3
SUPPORT_BOT_MEMORY_MIN_SCORE=0.35
SUPPORT_BOT_MESSAGE_RETENTION_DAYS=30
SUPPORT_BOT_CONFIRMATION_TTL_SECONDS=600
SUPPORT_BOT_CONFIRMATION_RETENTION_DAYS=7
SUPPORT_BOT_ACCESS_SNAPSHOT_MAX=100000
SUPPORT_BOT_MAX_GROUPS=800
SUPPORT_BOT_GATEWAY_RATE_PER_MIN=2000

# --- Mini-app self-service write actions (carrierMiniAppActions.routes.ts) ---
FF_MINIAPP_CARD_WRITES_ENABLED=0     # C-16 override, C-1/C-3 status, C-4/5 limits, C-26 info, C-10 fraud req
FF_SUPPORT_BOT_IDEMPOTENCY=1         # required in production; migrations 0076/0081/0083 + confirmation metadata
NOTIFY_POLL_CARRIERS=                # comma-separated pilot carrier ids for notification pollers (empty = off)
FF_MINIAPP_MONEY_CODE_ENABLED=0      # C-17 money-code preview/draw (servercrm owns the limit math)
MINIAPP_LIMIT_CHANGE_MAX=350         # cap on a single mini-app limit CHANGE (delta, not absolute)

# Local dev only: lend the static API_KEY session a Zoho user id so owner-scoped panels (CS Home
# tiles, retention desk quota) return data instead of failing closed with "No Zoho user id on the
# request for owner-scoped data". Ignored entirely when NODE_ENV=production. Blank = off.
DEV_MOCK_ZOHO_USER_ID=
