{
  "name": "octane-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "bash scripts/dev-local.sh",
    "tunnel": "bash scripts/db-tunnel.sh",
    "build": "tsc -p tsconfig.build.json",
    "build:widget": "corepack pnpm -C apps/mytrion-crm install --frozen-lockfile && corepack pnpm -C apps/mytrion-crm build",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/guardedMigrate.ts",
    "db:migrate:raw": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "seed:support-kb": "tsx scripts/seed-support-bot-knowledge.ts",
    "smoke:support-kb": "tsx scripts/smoke-support-bot-knowledge.ts",
    "seed:scope-risks": "tsx scripts/seed-scope-risks.ts",
    "knowledge:sync-platform": "tsx scripts/syncPlatformKnowledge.ts",
    "meta:zoho-crm": "tsx metadataScripts/zohoCrmAnalyzer.ts",
    "meta:zoho-desk": "tsx metadataScripts/zohoDeskAnalyzer.ts",
    "meta:zoho-people": "tsx metadataScripts/zohoPeopleAnalyzer.ts",
    "meta:zoho-people-records": "tsx metadataScripts/zohoPeopleBulkFetch.ts",
    "meta:fetch": "tsx metadataScripts/zohoMetadataFetcher.ts",
    "meta:dwh": "tsx metadataScripts/dwhAnalyzer.ts",
    "meta:pg-catalog": "tsx metadataScripts/pgCatalogAnalyzer.ts",
    "meta:pg-table": "tsx metadataScripts/pgTableMetadata.ts",
    "dwh:inspect": "tsx scripts/dwhInspect.ts",
    "pg:inspect": "tsx scripts/pgInspect.ts",
    "mytrion:inspect": "tsx scripts/mytrionInspect.ts",
    "mysql:inspect": "tsx scripts/mysqlInspect.ts",
    "zoho:smoke": "tsx scripts/zoho-smoke.ts",
    "zoho:mcp-probe": "tsx scripts/zoho-mcp-probe.ts",
    "dbt:smoke": "tsx scripts/dbt-mcp-smoke.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:retrieval": "tsx scripts/evalRetrieval.ts",
    "eval:rag-excellence": "node --import tsx scripts/evalRagExcellence.ts",
    "eval:live": "tsx scripts/evalLive.ts",
    "analytics:smoke": "tsx scripts/analytics-smoke.ts",
    "dropbox:smoke": "tsx scripts/dropbox-smoke.ts",
    "hr:attendance-local": "tsx scripts/hr-attendance-local.ts",
    "hr:fix-work-dates": "tsx scripts/hr-recompute-work-dates.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@composio/core": "^0.13.1",
    "@composio/langchain": "^0.10.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.3",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "deepagents": "1.10.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.0",
    "jose": "^5.9.3",
    "langchain": "^1.5.2",
    "mammoth": "^1.12.0",
    "mysql2": "^3.22.6",
    "openai": "^4.65.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "pg-boss": "^12.24.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.4",
    "soap": "^1.1.0",
    "unpdf": "^1.6.2",
    "ws": "^8.21.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "archiver-utils@5.0.2": "patches/archiver-utils@5.0.2.patch"
    },
    "overrides": {
      "axios@>=1.15.0 <1.18.0": "1.19.0",
      "brace-expansion@1.1.15": "1.1.16",
      "brace-expansion@2.1.1": "2.1.2",
      "brace-expansion@5.0.6": "5.0.9",
      "exceljs>archiver": "7.0.1",
      "exceljs>unzipper": "0.12.5",
      "exceljs>uuid": "11.1.1",
      "archiver@7.0.1>readdir-glob": "3.0.0",
      "archiver-utils@5.0.2>glob": "13.0.6",
      "fast-uri@3.1.2": "3.1.5",
      "form-data@4.0.5": "4.0.6"
    }
  }
}
