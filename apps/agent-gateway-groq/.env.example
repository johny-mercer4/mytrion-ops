TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=octane_support_ai_bot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TIMEOUT_MS=90000
# Bounded burst handling. Tune from production metrics and the OpenAI account tier.
MAX_CONCURRENT_TURNS=8
MAX_PENDING_TURNS=2000
MAX_PENDING_PER_USER=5
# Telegram output safety: ~25 global operations/s and <=20 group messages/minute.
TELEGRAM_MIN_GAP_MS=40
TELEGRAM_CHAT_MESSAGE_MIN_GAP_MS=3100
TELEGRAM_SEND_TIMEOUT_MS=10000
TELEGRAM_INGRESS_CONCURRENCY=32
OCTANE_API_BASE=http://localhost:3000
OCTANE_INTERNAL_API_KEY=
# Multi-chat normally resolves through Mytrion's chat map; these are a single-group fallback:
OCTANE_GROUP_CHAT_ID=
OCTANE_CARRIER_ID=
OCTANE_MINIAPP_LINK=
MONITOR_TOKEN=
