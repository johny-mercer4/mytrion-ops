TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=octane_support_ai_bot
# This poller is the CARRIER / support bot only. Do not put HORIZON_BOT_TOKEN here —
# Mytrion Horizon (worker CRM Mini App) is a separate bot, webhooked by the API.
# At 800 groups, production should route only mentions/replies and their 10-minute follow-ups.
# all_registered intentionally sends every registered user's message to the semantic router.
TELEGRAM_ENGAGEMENT_MODE=direct
# One DB-backed long-poll leader; additional replicas stay warm and take over after expiry.
GATEWAY_LEASE_ENABLED=1
GATEWAY_LEASE_TTL_SECONDS=45
GATEWAY_LEASE_RENEW_MS=10000
# Combine one user's consecutive fragments into a single request.
TELEGRAM_BURST_QUIET_MS=3000
TELEGRAM_BURST_MAX_MS=120000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Structured semantic ingress/tool router. It is separately concurrency-bounded.
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_ROUTER_MAX_OUTPUT_TOKENS=320
OPENAI_ROUTER_MAX_CONCURRENT=16
OPENAI_ROUTER_QUEUE_MAX=200
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TIMEOUT_MS=90000
# Set these to the actual limits shown for the production OpenAI project.
OPENAI_RPM_LIMIT=60
OPENAI_TPM_LIMIT=100000
OPENAI_RATE_WAIT_MAX_MS=30000
OPENAI_429_RETRY_MAX=1
OPENAI_CIRCUIT_429_THRESHOLD=3
OPENAI_CIRCUIT_COOLDOWN_MS=30000
# Capability switches: comma-separated service=on|off overrides. Money Code is OFF by default.
# Available: identity, knowledge, cards, funds, transactions, money_code, billing,
# service_requests, tracking, vision, memory. Memory also requires backend
# FF_SUPPORT_BOT_MEMORY=1 + migration 0078. Environment changes require a process restart.
AGENT_SERVICE_FLAGS=money_code=off,memory=off
# Memory recall is synchronous; turn-summary commits use this bounded async queue.
MEMORY_COMMIT_CONCURRENCY=2
MEMORY_COMMIT_QUEUE_MAX=500
# Bounded burst handling. Tune from production metrics and the OpenAI account tier.
MAX_CONCURRENT_TURNS=8
MAX_CONCURRENT_PER_CARRIER=2
MAX_PENDING_REQUESTS=200
MAX_PENDING_PER_USER=3
MAX_PENDING_PER_CARRIER=10
MAX_REQUEST_QUEUE_WAIT_MS=45000
# Telegram output safety: ~25 global operations/s and <=20 group messages/minute.
TELEGRAM_MIN_GAP_MS=40
TELEGRAM_CHAT_MESSAGE_MIN_GAP_MS=3100
TELEGRAM_SEND_TIMEOUT_MS=10000
TELEGRAM_SEND_QUEUE_MAX=1000
TELEGRAM_INGRESS_CONCURRENCY=32
TELEGRAM_BURST_MAX_KEYS=5000
TELEGRAM_BURST_MAX_ITEMS_PER_KEY=12
OCTANE_API_BASE=http://localhost:3000
OCTANE_TENANT_ID=octane
OCTANE_SUPPORT_BOT_API_KEY=
# Development migration fallback only; production does not accept this broader key.
OCTANE_INTERNAL_API_KEY=

# Privacy defaults: only model-engaged inbound messages, no plaintext names, 30-day retention.
MESSAGE_LOG_MODE=engaged
MESSAGE_LOG_LOCAL_ENABLED=0
TURN_LOG_LOCAL_ENABLED=0
MESSAGE_LOG_STORE_NAMES=0
MESSAGE_LOG_MAX_CHARS=2000
MESSAGE_LOG_RETENTION_DAYS=30
ACCESS_SNAPSHOT_REFRESH_MS=120000
ACCESS_SNAPSHOT_STALE_GRACE_MS=1800000
ACCESS_SNAPSHOT_MAX_USERS=100000
SESSION_MAX_SESSIONS=1000
SESSION_MAX_PERSIST_BYTES=10000000
SESSION_PERSIST_ENABLED=0
# Multi-chat normally resolves through Mytrion's chat map; these are a single-group fallback:
OCTANE_GROUP_CHAT_ID=
OCTANE_CARRIER_ID=
ALLOW_LEGACY_CHAT_FALLBACK=0
MAX_MANAGED_GROUPS=800
CHAT_MAP_STALE_GRACE_MS=1800000
OCTANE_MINIAPP_LINK=
MONITOR_TOKEN=
MONITOR_HOST=0.0.0.0
