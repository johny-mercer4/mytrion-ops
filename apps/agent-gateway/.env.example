TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=octane_support_ai_bot
# This poller is the CARRIER / support bot only. Do not put HORIZON_BOT_TOKEN here —
# Mytrion Horizon (worker CRM Mini App) is a separate bot, webhooked by the API.
# Auth token pool (subscription `claude setup-token`). Give SEVERAL so busy days across many
# groups fail over instead of going dark: one token limited → next token continues the same
# conversation. Any of these forms work (merged, de-duplicated):
CLAUDE_CODE_OAUTH_TOKENS=         # comma/newline list: tok1,tok2,tok3   (preferred for a pool)
#CLAUDE_CODE_OAUTH_TOKEN_1=       # or numbered slots _1.._10
#CLAUDE_CODE_OAUTH_TOKEN_2=
CLAUDE_CODE_OAUTH_TOKEN=          # or a single token (legacy — one token, no rotation)
#AUTH_COOLDOWN_MS=3600000         # fallback cooldown when a limit reports no reset time (1h)
#MAX_CONCURRENT_TURNS=0           # 0/unset = UNLIMITED (no user waits on the bot being busy).
                                  # Set ≥1 only to bound CLI subprocesses on a tiny box.
#TELEGRAM_MIN_GAP_MS=40           # min spacing between outbound Telegram sends (~25/s) — avoids Bot-API 429
#ALL_LIMITED_FASTFAIL_MS=30000    # when all tokens cooled & soonest reset is farther than this, fail fast
GATEWAY_MODEL=claude-sonnet-4-5
OCTANE_API_BASE=http://localhost:3000
OCTANE_INTERNAL_API_KEY=
OCTANE_TENANT_ID=octane
# MVP: bitta guruh. Multi-chat rejimda chat-map (mytrion) ishlatiladi, bular fallback:
OCTANE_GROUP_CHAT_ID=
OCTANE_CARRIER_ID=
